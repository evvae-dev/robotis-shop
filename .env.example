# Firebase Console → 프로젝트 설정 → 내 앱 → 웹 앱의 공개 설정값
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Vercel: 서비스 계정 JSON 전체를 Secret 타입으로 등록합니다. NEXT_PUBLIC_ 접두사를 붙이지 않습니다.
FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON=
# 로컬 개발: 위 JSON 환경변수가 비어 있으면 이 파일을 읽습니다. JSON 파일은 Git에 추가하지 않습니다.
FIREBASE_ADMIN_KEY_PATH=./robotis-shop-firebase-adminsdk.json
# 생략하면 cad:setup으로 설치한 로컬 실행 파일을 사용합니다.
CAD_PYTHON_PATH=
BLENDER_PATH=
# 원본 STEP·변환 GLB 저장 폴더. 기본값은 프로젝트의 .data/models입니다.
CAD_STORAGE_PATH=
# 로컬은 비워 두고, Vercel에만 Cloud Run 기본 URL(/convert 제외)을 설정합니다.
CAD_API_URL=
# 원격 변환 원본·GLB의 영구 저장용 비공개 Cloud Storage 버킷 이름입니다(gs:// 제외).
CAD_STORAGE_BUCKET=
