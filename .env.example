# Firebase Console → 프로젝트 설정 → 내 앱 → 웹 앱의 공개 설정값
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# 서버 전용 서비스 계정 파일 경로입니다. JSON 파일은 Git에 추가하지 않습니다.
FIREBASE_ADMIN_KEY_PATH=./robotis-shop-firebase-adminsdk.json
# 생략하면 cad:setup으로 설치한 로컬 실행 파일을 사용합니다.
CAD_PYTHON_PATH=
BLENDER_PATH=
# 원본 STEP·변환 GLB 저장 폴더. 기본값은 프로젝트의 .data/models입니다.
CAD_STORAGE_PATH=
